{
    "name": "Disintegrate",
    "version": "1.0",
    "description": "Disintegrate is a tool that blocks incoming JavaScript requests for adverts in web pages, allowing users to browse the web without being interrupted by ads.",
    "manifest_version": 3,
    "permissions": ["declarativeNetRequest", "declarativeNetRequestFeedback", "storage", "activeTab"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "default_filters",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    },
    "action": {
        "default_popup": "popups/popup.html",
        "default_title": "Disintegrate"
    },

    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
